package com.pc5.android

import android.content.Context
import java.io.File
import java.net.HttpURLConnection
import java.net.URL
import java.net.URLEncoder

/** Fetches the subscription JSON and persists it so the service survives process death. */
object ConfigStore {

    const val BACKEND = "https://pc5-android.onrender.com"

    private fun file(ctx: Context) = File(ctx.filesDir, "config.json")

    fun cached(ctx: Context): String? =
        file(ctx).takeIf { it.exists() }?.readText()?.takeIf { it.isNotBlank() }

    fun save(ctx: Context, json: String) {
        file(ctx).writeText(json)
    }

    fun clear(ctx: Context) {
        file(ctx).delete()
    }

    fun subUrl(key: String, did: String, mode: String): String {
        val base = "$BACKEND/sub?key=${enc(key)}&did=${enc(did)}"
        return if (mode.isBlank() || mode == "off") base else "$base&mode=${enc(mode)}"
    }

    /** Blocking fetch. Call from a worker thread only. */
    fun fetch(key: String, did: String, mode: String): String {
        val conn = (URL(subUrl(key, did, mode)).openConnection() as HttpURLConnection).apply {
            connectTimeout = 15_000
            readTimeout = 15_000
            requestMethod = "GET"
            instanceFollowRedirects = true
            setRequestProperty("User-Agent", "PC5Android/2.0")
            setRequestProperty("Accept", "application/json")
        }
        try {
            val code = conn.responseCode
            if (code !in 200..299) throw IllegalStateException("sub HTTP $code")
            val body = conn.inputStream.bufferedReader().use { it.readText() }
            if (!body.trimStart().startsWith("{")) throw IllegalStateException("sub returned non-JSON")
            return body
        } finally {
            conn.disconnect()
        }
    }

    private fun enc(s: String): String = URLEncoder.encode(s, "UTF-8")
}
