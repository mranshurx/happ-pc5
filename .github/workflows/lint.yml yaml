name: lint

on:
  pull_request:
    branches: [main]

permissions:
  contents: read

jobs:
  android-lint:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Stub AAR so lint can resolve the module
        run: mkdir -p android/app/libs && touch android/app/libs/pc5core.aar
      - working-directory: android
        run: gradle --no-daemon :app:lintDebug
