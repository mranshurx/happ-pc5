name: build

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: build-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: write

env:
  NDK_VERSION: '26.1.10909125'
  GO_VERSION: '1.24'
  GRADLE_VERSION: '8.9'

jobs:
  preflight:
    name: preflight
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    outputs:
      core_sha: ${{ steps.resolve.outputs.sha }}
    steps:
      - uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}

      - name: Resolve fork
        id: resolve
        run: |
          set -euo pipefail
          PSEUDO=$(go list -m -f '{{.Version}}' github.com/Happ-proxy/Xray-core@main)
          if [ -z "$PSEUDO" ]; then
            echo "::error::could not resolve Happ-proxy/Xray-core@main"
            exit 1
          fi
          echo "resolved: $PSEUDO"
          echo "sha=$PSEUDO" >> "$GITHUB_OUTPUT"

      - name: Check module path is replaceable
        run: |
          set -euo pipefail
          MOD=$(go list -m -f '{{.Path}}' github.com/Happ-proxy/Xray-core@main)
          echo "module path: $MOD"
          if [ "$MOD" != "github.com/xtls/xray-core" ]; then
            echo "::error::fork renamed its module path to '$MOD'; update the imports and the replace target"
            exit 1
          fi

  core:
    name: core (gomobile)
    needs: preflight
    runs-on: ubuntu-24.04
    timeout-minutes: 50
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: ${{ env.GO_VERSION }}
          cache: false

      - uses: actions/cache@v4
        with:
          path: |
            ~/go/pkg/mod
            ~/.cache/go-build
          key: gomod-${{ runner.os }}-${{ hashFiles('core/go.mod', 'core/go.sum') }}
          restore-keys: gomod-${{ runner.os }}-

      - uses: android-actions/setup-android@v3

      - name: Install NDK
        run: |
          yes | sdkmanager --licenses > /dev/null || true
          sdkmanager "ndk;${NDK_VERSION}"

      - name: Install gomobile
        run: |
          go install golang.org/x/mobile/cmd/gomobile@latest
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"

      - name: gomobile init
        env:
          ANDROID_NDK_HOME: ${{ env.ANDROID_HOME }}/ndk/${{ env.NDK_VERSION }}
        run: gomobile init

      - name: Build AAR
        working-directory: core
        env:
          ANDROID_NDK_HOME: ${{ env.ANDROID_HOME }}/ndk/${{ env.NDK_VERSION }}
          CORE_VERSION: ${{ needs.preflight.outputs.core_sha }}
        run: ./build.sh

      - name: Upload AAR
        uses: actions/upload-artifact@v4
        with:
          name: pc5core-aar
          path: android/app/libs/pc5core.aar
          retention-days: 7
          if-no-files-found: error

  apk:
    name: apk
    needs: [preflight, core]
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4

      - uses: actions/download-artifact@v4
        with:
          name: pc5core-aar
          path: android/app/libs

      - name: Verify AAR is a real archive
        run: |
          set -euo pipefail
          unzip -l android/app/libs/pc5core.aar | head -20
          unzip -l android/app/libs/pc5core.aar | grep -q 'classes.jar' \
            || { echo "::error::AAR has no classes.jar"; exit 1; }

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: ${{ env.GRADLE_VERSION }}

      - name: Lint
        continue-on-error: true
        working-directory: android
        run: gradle --no-daemon :app:lintDebug

      - name: Decode keystore
        if: startsWith(github.ref, 'refs/tags/v')
        env:
          KEYSTORE_B64: ${{ secrets.KEYSTORE_B64 }}
        run: |
          set -euo pipefail
          if [ -z "${KEYSTORE_B64:-}" ]; then
            echo "::error::KEYSTORE_B64 secret is not set"
            exit 1
          fi
          printf '%s' "$KEYSTORE_B64" | base64 -d > "$RUNNER_TEMP/pc5.keystore"
          test -s "$RUNNER_TEMP/pc5.keystore"

      - name: Build debug
        working-directory: android
        run: gradle --no-daemon :app:assembleDebug

      - name: Build release
        if: startsWith(github.ref, 'refs/tags/v')
        working-directory: android
        env:
          PC5_KEYSTORE: ${{ runner.temp }}/pc5.keystore
          PC5_STORE_PASSWORD: ${{ secrets.STORE_PASSWORD }}
          PC5_KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          PC5_KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: gradle --no-daemon :app:assembleRelease

      - name: Verify APKs exist
        run: |
          set -euo pipefail
          mkdir -p out
          find android/app/build/outputs/apk -name '*.apk' -exec cp {} out/ \;
          test "$(find out -name '*.apk' | wc -l)" -ge 1 || { echo "::error::no APK produced"; exit 1; }
          ls -la out

      - uses: actions/upload-artifact@v4
        with:
          name: apk-${{ github.sha }}
          path: out/*.apk
          retention-days: 14
          if-no-files-found: error

      - name: Release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: out/*.apk
          generate_release_notes: true
          fail_on_unmatched_files: true
